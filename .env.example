# ============================================================
# SIH26179 PostgreSQL configuration
# ============================================================
# After restoring database/RetailEdge_Final_Database.sql into
# a local PostgreSQL database named sih26179, set:
# DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/sih26179
#
# If DATABASE_URL is left blank, the app uses its local SQLite
# workflow database and the bundled CSV files as a fallback.
DATABASE_URL=
